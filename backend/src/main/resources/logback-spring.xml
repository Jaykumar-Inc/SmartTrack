<configuration>
 <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
  <!-- Never print framework DEBUG bodies: they may contain access tokens or location. -->
  <filter class="ch.qos.logback.classic.filter.ThresholdFilter"><level>INFO</level></filter>
  <encoder><pattern>%date{ISO8601,UTC} %-5level %logger{36} - %msg%n</pattern></encoder>
 </appender>
 <root level="INFO"><appender-ref ref="CONSOLE"/></root>
</configuration>
