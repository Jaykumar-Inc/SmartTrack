# Configuration reference only. Spring Boot and the supplied scripts do NOT
# automatically read .env files. Set environment variables in your shell, or
# use a local dotenv tool. Never commit the filled-in .env copy.

# Default Spring Boot settings (the Windows launcher selects port 8087).
SMARTTRACK_BIND=127.0.0.1
SMARTTRACK_PORT=8087
SMARTTRACK_DB_URL=jdbc:mysql://127.0.0.1:3306/smarttrack?connectionTimeZone=UTC
SMARTTRACK_DB_USER=smarttrack
# Required for a manually configured MySQL instance; supply privately.
SMARTTRACK_DB_PASSWORD=
SMARTTRACK_ALLOW_SIMULATOR=false
SMARTTRACK_RETENTION_DAYS=30

# Optional desktop session; prefer signing in through the application.
SMARTTRACK_BACKEND=http://127.0.0.1:8087
SMARTTRACK_USER_TOKEN=

# Optional signed Android release; supply an external private keystore path.
SMARTTRACK_KEYSTORE=
SMARTTRACK_STORE_PASSWORD=
SMARTTRACK_KEY_ALIAS=
SMARTTRACK_KEY_PASSWORD=
