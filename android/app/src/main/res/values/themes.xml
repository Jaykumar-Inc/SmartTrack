<resources>
    <style name="Theme.SmartTrack" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item><item name="colorPrimaryVariant">@color/elevated</item>
        <item name="colorSecondary">@color/accent</item><item name="colorOnPrimary">@color/canvas</item>
        <item name="colorSurface">@color/surface</item><item name="colorOnSurface">@color/text</item>
        <item name="elevationOverlayEnabled">false</item>
        <item name="android:windowBackground">@color/canvas</item><item name="android:fontFamily">sans</item>
        <item name="android:colorBackground">@color/canvas</item>
        <item name="android:textColorPrimary">@color/text</item><item name="android:textColorSecondary">@color/muted</item>
        <item name="android:statusBarColor">@color/canvas</item><item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
    <style name="TextAppearance.SmartTrack.Toolbar" parent="TextAppearance.MaterialComponents.Headline6"><item name="android:textSize">20sp</item><item name="android:fontFamily">sans-serif-medium</item></style>
    <style name="TextAppearance.SmartTrack.Subtitle" parent="TextAppearance.MaterialComponents.Caption"><item name="android:textSize">12sp</item></style>
    <style name="TextAppearance.SmartTrack.Navigation" parent="TextAppearance.MaterialComponents.Caption"><item name="android:textSize">11sp</item><item name="android:fontFamily">sans-serif-medium</item></style>
</resources>
